{
  "name": "mes-comptes",
  "private": true,
  "version": "2.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "VITE_V2_USE_PRODUCTION=true vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build:production",
    "deploy": "gh-pages -d dist",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --config firebase.v2.json --project demo-mes-comptes-v2 \"node --test tests/emulator/*.test.mjs\"",
    "test:e2e": "firebase emulators:exec --only firestore,auth --config firebase.v2.json --project demo-mes-comptes-v2 \"playwright test\"",
    "test:offline": "OFFLINE_E2E=1 firebase emulators:exec --only firestore,auth --config firebase.v2.json --project demo-mes-comptes-v2 \"playwright test tests/browser/offline.spec.js\"",
    "android:sync": "node scripts/build-android.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@tailwindcss/vite": "^4.2.2",
    "firebase": "^12.12.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.5",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.32.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.4.0",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.2.0"
  }
}
