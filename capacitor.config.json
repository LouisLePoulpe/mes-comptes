{
  "appId": "fr.louislepoulpe.mescomptes",
  "appName": "Mes Comptes",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#030712"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    }
  },
  "includePlugins": [
    "@capacitor/app",
    "@capacitor/filesystem",
    "@capacitor/share"
  ]
}
